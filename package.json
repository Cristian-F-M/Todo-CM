{
	"name": "todo-cm",
	"version": "1.21.2",
	"private": false,
	"description": "Android application made with react-native + expo, which allows the user to create tasks, organize them into folders, mark them as completed, allows changing themes, creation of automatic and manual themes 100% customizable.",
	"keywords": [
		"todo",
		"CM",
		"lista de tareas",
		"tareas",
		"tasks",
		"folders",
		"themes",
		"temas",
		"personalización",
		"theme-creation"
	],
	"author": {
		"email": "cfmorales.diaz@gmail.com",
		"name": "Cristian Morales",
		"url": "https://github.com/Cristian-F-M"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Cristian-F-M/Todo-CM.git"
	},
	"license": "MIT",
	"main": "expo-router/entry",
	"scripts": {
		"start": "expo start",
		"android": "expo run:android",
		"prebuild": "expo prebuild",
		"postinstall": "patch-package",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"lint": "eslint .",
		"build:apk": "bunx expo prebuild --clean && cd android && ./gradlew assembleRelease",
		"build:release": "bun run align:apk && bun run sign:apk",
		"align:apk": "shx mkdir -p output && $ANDROID_HOME/build-tools/36.0.0/zipalign -f -v 4 android/app/build/outputs/apk/release/app-release.apk output/app-release.apk",
		"sign:apk": "$ANDROID_HOME/build-tools/36.0.0/apksigner sign --ks credentials/android/todo-cm.jks --ks-key-alias cmorales --out output/app-release.apk output/app-release.apk",
		"copy:debug": "shx mkdir -p output && shx cp android/app/build/outputs/apk/debug/app-debug.apk output/app-debug.apk"
	},
	"dependencies": {
		"@animatereactnative/marquee": "0.5.2",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-native-community/datetimepicker": "8.6.0",
		"@react-native-community/netinfo": "11.5.2",
		"@react-native-picker/picker": "2.11.4",
		"@tabler/icons-react-native": "3.37.1",
		"expo": "^55.0.8",
		"expo-blur": "~55.0.10",
		"expo-clipboard": "~55.0.9",
		"expo-constants": "~55.0.9",
		"expo-dev-client": "~55.0.18",
		"expo-device": "~55.0.10",
		"expo-file-system": "~55.0.11",
		"expo-haptics": "~55.0.9",
		"expo-intent-launcher": "~55.0.9",
		"expo-linking": "~55.0.8",
		"expo-notifications": "~55.0.13",
		"expo-router": "~55.0.7",
		"expo-sharing": "~55.0.14",
		"expo-splash-screen": "~55.0.12",
		"expo-sqlite": "~55.0.11",
		"expo-status-bar": "~55.0.4",
		"expo-system-ui": "~55.0.10",
		"nativewind": "^4.1.23",
		"react": "19.2.0",
		"react-native": "0.83.2",
		"react-native-bouncy-checkbox": "^4.1.2",
		"react-native-circular-progress": "1.4.1",
		"react-native-gesture-handler": "~2.30.0",
		"react-native-logs": "5.5.0",
		"react-native-markdown-renderer": "4.1.0",
		"react-native-modalize": "^2.1.1",
		"react-native-paper-dates": "0.23.5",
		"react-native-portalize": "1.0.7",
		"react-native-reanimated": "4.2.1",
		"react-native-safe-area-context": "~5.6.0",
		"react-native-screens": "~4.23.0",
		"react-native-svg": "15.15.3",
		"react-native-uuid": "^2.0.3",
		"react-native-worklets": "0.7.2",
		"react-native-zip-archive": "7.0.2",
		"reanimated-color-picker": "4.2.0",
		"tailwind-merge": "3.5.0",
		"tailwindcss": "^3.4.17",
		"zod": "4.3.6",
		"zustand": "^5.0.11"
	},
	"devDependencies": {
		"@babel/core": "^7.25.2",
		"@biomejs/biome": "^2.4.2",
		"@types/react": "~19.2.10",
		"eslint": "^8.57.0",
		"eslint-config-expo": "~55.0.0",
		"eslint-config-prettier": "^10.0.2",
		"eslint-plugin-prettier": "^5.2.3",
		"patch-package": "^8.0.1",
		"prettier": "^3.5.3",
		"shx": "0.4.0",
		"typescript": "~5.9.2"
	}
}